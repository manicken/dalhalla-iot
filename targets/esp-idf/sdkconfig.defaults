# same tick rate as the Arduino core, millis() resolution and vTaskDelay(1) == 1 ms
CONFIG_FREERTOS_HZ=1000
# DALHAL runs its main loop in the main task, the Arduino loopTask has 8 KB
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# esp32dev boards have 4 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# same partition table as the Arduino builds (app0/app1 OTA, coredump, spiffs = LittleFS)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions_32mbit.csv"
# WebSocketAPI on esp_http_server
CONFIG_HTTPD_WS_SUPPORT=y
# browsers send long headers (user agent, cookies), the default 512 gives "431 Request Header Fields Too Large"
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# needed for ioctl(FIONREAD), i.e. WiFiClient::available() (OTA, MQTT)
CONFIG_LWIP_SO_RCVBUF=y
# the default 10 sockets run out with one browser: httpd (12 connections + 2 internal, HttpServer.cpp),
# OTA (UDP + TCP while updating), MQTT, SNTP, DNS. Without a free socket accept() fails (ENFILE) before
# httpd can drop its oldest connection, e.g. the WebSocket of the frontend could not connect.
CONFIG_LWIP_MAX_SOCKETS=20
# the same LittleFS on-disk version as the Arduino core (2.0.x is built with DISK_VERSION_2_0):
# with the default (most recent = 2.1) the first write upgrades the filesystem, the Arduino firmware
# then can not mount it and formats it (LittleFS.begin(formatOnFail = true)), all files are lost
CONFIG_LITTLEFS_MULTIVERSION=y
CONFIG_LITTLEFS_DISK_VERSION_2_0=y
